<?php

/**
 * @file
 * Tabulky evidence a složky pro dávky.
 *
 * Evidence je jediná pojistka proti druhému odeslání téhož hovoru, takže se
 * při odinstalaci modulu NEMAŽE sama — viz api_csobrec_uninstall().
 */

declare(strict_types=1);

use Drupal\Core\File\FileSystemInterface;

/**
 * Implements hook_schema().
 */
function api_csobrec_schema(): array {
  $schema['api_csobrec_odeslano'] = [
    'description' => 'Hovory, které už ČSOB dostal. Vede se po hovorech, aby se jedna nahrávka neodeslala dvakrát.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'hovor' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'description' => 'Identifikátor aktivity v Datele.'],
      'fronta' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'davka' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'description' => 'Jméno dávky, ve které hovor odešel.'],
      'odeslano' => ['type' => 'int', 'not null' => TRUE, 'description' => 'Kdy dávka odešla (timestamp).'],
    ],
    'primary key' => ['id'],
    'unique keys' => ['hovor' => ['hovor']],
    'indexes' => ['davka' => ['davka'], 'odeslano' => ['odeslano']],
  ];
  $schema['api_csobrec_davka'] = [
    'description' => 'Co se v který den stalo: jedna řádka na jeden běh. Žádná telefonní čísla ani jména.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'den' => ['type' => 'varchar', 'length' => 10, 'not null' => TRUE, 'description' => 'Den, za který se předávalo (YYYY-MM-DD).'],
      'jmeno' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'description' => 'Jméno dávky, např. DA_2026102605.'],
      'hovoru' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'nahrano' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'bajtu' => ['type' => 'int', 'size' => 'big', 'not null' => TRUE, 'default' => 0],
      'zalozeno' => ['type' => 'int', 'not null' => TRUE],
      'stav' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'description' => 'bezi | odeslano | chyba | preskoceno'],
      'chyba' => ['type' => 'text', 'not null' => FALSE, 'description' => 'Hlášení chyby bez tajemství a bez osobních údajů.'],
    ],
    'primary key' => ['id'],
    'indexes' => ['den' => ['den'], 'zalozeno' => ['zalozeno']],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 */
function api_csobrec_install(): void {
  $fs = \Drupal::service('file_system');
  assert($fs instanceof FileSystemInterface);
  foreach (['private://api_csobrec/prac', 'private://api_csobrec/davky'] as $dir) {
    $fs->prepareDirectory($dir, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  }
}

/**
 * Implements hook_uninstall().
 */
function api_csobrec_uninstall(): void {
  \Drupal::logger('api_csobrec')->warning('Modul odinstalován. Tabulka api_csobrec_odeslano zůstává: je to jediný doklad o tom, co už ČSOB dostal. Smazat ji může jen člověk, který ví, co dělá.');
}

/**
 * Implements hook_requirements().
 */
function api_csobrec_requirements(string $phase): array {
  $pozadavky = [];
  if ($phase !== 'runtime') {
    return $pozadavky;
  }

  if (!\Drupal::service('stream_wrapper_manager')->isValidScheme('private')) {
    $pozadavky['api_csobrec_private'] = [
      'title' => t('Předávka ČSOB'),
      'value' => t('Privátní souborový systém není nastaven'),
      'description' => t('Nahrávky zákazníků se ukládají do private://api_csobrec. Nastavte $settings[\'file_private_path\'] v settings.php.'),
      'severity' => REQUIREMENT_ERROR,
    ];
  }

  // ffmpeg: bez něj se nahrávka nepřevede na MP3 a dávka nevznikne.
  $ffmpeg = (string) \Drupal::config('api_csobrec.settings')->get('ffmpeg') ?: 'ffmpeg';
  $kde = @shell_exec(sprintf('command -v %s 2>/dev/null', escapeshellarg($ffmpeg)));
  $pozadavky['api_csobrec_ffmpeg'] = $kde
    ? ['title' => t('Předávka ČSOB: ffmpeg'), 'value' => t('nalezen'), 'severity' => REQUIREMENT_OK]
    : [
      'title' => t('Předávka ČSOB: ffmpeg'),
      'value' => t('nenalezen'),
      'description' => t('Nahrávky se převádějí na MP3 ffmpegem. Nainstalujte ho, nebo doplňte cestu v nastavení.'),
      'severity' => REQUIREMENT_ERROR,
    ];

  if (!\Drupal::service('settings')->get('api_csobrec_daktela_token')) {
    $pozadavky['api_csobrec_token'] = [
      'title' => t('Předávka ČSOB: token k Datele'),
      'value' => t('není v settings.php'),
      'description' => t('Token se do configu nepíše (config se exportuje). Patří do $settings[\'api_csobrec_daktela_token\'] v settings.php.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  $nastaveni = \Drupal::config('api_csobrec.settings');

  if ((array) $nastaveni->get('fronty') === []) {
    $pozadavky['api_csobrec_fronty'] = [
      'title' => t('Předávka ČSOB: fronty'),
      'value' => t('žádná fronta není nastavená'),
      'description' => t('Bez front se Daktely nikdo neptá a každé ráno projde naprázdno. Doplňte je v nastavení modulu.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  if ((string) $nastaveni->get('sftp_cil') === '') {
    $pozadavky['api_csobrec_cil'] = [
      'title' => t('Předávka ČSOB: cílová cesta na jejich SFTP'),
      'value' => t('není vyplněná'),
      'description' => t('Cestu, do které se dávka ukládá, musí určit ČSOB. Dokud tu není, ostrý běh skončí chybou a nic neodejde — zkouška s --bez-nahrani funguje.'),
      'severity' => REQUIREMENT_ERROR,
    ];
  }

  if (!$nastaveni->get('sftp_overit_klic')) {
    $pozadavky['api_csobrec_klic'] = [
      'title' => t('Předávka ČSOB: klíč jejich serveru'),
      'value' => t('neověřuje se'),
      'description' => t('Otisk klíče serveru si každý běh zapisuje do logu. Nechte si ho potvrdit od ČSOB (ne z našeho logu, ten by potvrdil i podvodníka), vyplňte ho v nastavení a zapněte ověřování.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  return $pozadavky;
}
