<?php

/**
 * @file
 * HW Desk: hooks that Drupal still wants in a .module file.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Url;
use Drupal\file\FileInterface;
use Drupal\user\UserInterface;
use Drupal\hwdesk\Entity\Handover;
use Drupal\hwdesk\AssetCondition;
use Drupal\hwdesk\AssetStatus;
use Drupal\hwdesk\HandoverKind;
use Drupal\hwdesk\HandoverStatus;

/**
 * Allowed values for hwdesk_asset.type: keys and labels from configuration.
 *
 * @return array<string, string>
 */
function hwdesk_asset_type_options(?FieldStorageDefinitionInterface $definition = NULL, ?EntityInterface $entity = NULL): array {
  $types = \Drupal::config('hwdesk.settings')->get('asset_types') ?? [];
  $options = [];
  foreach ($types as $key => $label) {
    $options[(string) $key] = (string) $label;
  }
  return $options;
}

/**
 * Allowed values for hwdesk_asset.status.
 *
 * @return array<string, \Drupal\Core\StringTranslation\TranslatableMarkup>
 */
function hwdesk_asset_status_options(): array {
  return AssetStatus::options();
}

/**
 * Allowed values for hwdesk_asset.condition.
 *
 * @return array<string, \Drupal\Core\StringTranslation\TranslatableMarkup>
 */
function hwdesk_asset_condition_options(): array {
  return AssetCondition::options();
}

/**
 * Allowed values for hwdesk_handover.kind.
 *
 * @return array<string, \Drupal\Core\StringTranslation\TranslatableMarkup>
 */
function hwdesk_handover_kind_options(): array {
  return HandoverKind::options();
}

/**
 * Allowed values for hwdesk_handover.status.
 *
 * @return array<string, \Drupal\Core\StringTranslation\TranslatableMarkup>
 */
function hwdesk_handover_status_options(): array {
  return HandoverStatus::options();
}

/**
 * Implements hook_theme().
 */
function hwdesk_theme(): array {
  return [
    'hwdesk_protocol' => [
      'variables' => ['handover' => NULL, 'asset' => NULL, 'employee' => NULL, 'admin' => NULL, 'company' => '', 'confirmed_at' => ''],
    ],
    'hwdesk_label_sheet' => [
      'variables' => ['labels' => []],
    ],
    'hwdesk_dashboard' => [
      'variables' => ['tiles' => [], 'by_type' => [], 'by_location' => [], 'pending' => [], 'warranty' => []],
    ],
  ];
}

/**
 * Implements hook_mail().
 *
 * Every message is prepared by the handover service (subject, body lines);
 * this hook only copies them into the mail structure.
 */
function hwdesk_mail(string $key, array &$message, array $params): void {
  $message['subject'] = (string) ($params['subject'] ?? '');
  $message['body'] = array_values((array) ($params['body'] ?? []));
  if (!empty($params['attachment'])) {
    $message['params']['attachment'] = $params['attachment'];
  }
}

/**
 * Implements hook_cron().
 */
function hwdesk_cron(): void {
  \Drupal::service('hwdesk.handover')->expireOverdue();
}

/**
 * Implements hook_entity_operation().
 *
 * A pending handover can be cancelled from the list.
 */
function hwdesk_entity_operation(EntityInterface $entity, CacheableMetadata $cacheability): array {
  if ($entity instanceof Handover && $entity->getStatus() === HandoverStatus::Pending) {
    $cacheability->addCacheableDependency($entity);
    return [
      'cancel' => [
        'title' => t('Zrušit'),
        'weight' => 10,
        'url' => Url::fromRoute('hwdesk.handover.cancel', ['hwdesk_handover' => $entity->id()]),
      ],
    ];
  }
  return [];
}

/**
 * Implements hook_entity_insert().
 */
function hwdesk_entity_insert(EntityInterface $entity): void {
  if (str_starts_with($entity->getEntityTypeId(), 'hwdesk_') && $entity->getEntityTypeId() !== 'hwdesk_audit') {
    \Drupal::service('hwdesk.audit')->record($entity, 'insert');
  }
}

/**
 * Implements hook_entity_update().
 */
function hwdesk_entity_update(EntityInterface $entity): void {
  if (str_starts_with($entity->getEntityTypeId(), 'hwdesk_') && $entity->getEntityTypeId() !== 'hwdesk_audit') {
    \Drupal::service('hwdesk.audit')->record($entity, 'update');
  }
}

/**
 * Implements hook_entity_delete().
 */
function hwdesk_entity_delete(EntityInterface $entity): void {
  if (str_starts_with($entity->getEntityTypeId(), 'hwdesk_') && $entity->getEntityTypeId() !== 'hwdesk_audit') {
    \Drupal::service('hwdesk.audit')->record($entity, 'delete');
  }
}

/**
 * Implements hook_user_update().
 *
 * HR blocks the account → the administrators learn what has to come back.
 */
function hwdesk_user_update(UserInterface $account): void {
  $original = $account->getOriginal();
  if ($account->isBlocked() && $original instanceof UserInterface && $original->isActive()) {
    \Drupal::service('hwdesk.offboarding')->userBlocked($account);
  }
}

/**
 * Implements hook_file_download().
 *
 * Private files: administrators see everything; an employee may download
 * the protocol of their own handover and the attachments of what they hold.
 */
function hwdesk_file_download(string $uri): array|int|null {
  if (!str_starts_with($uri, 'private://hwdesk/')) {
    return NULL;
  }
  $account = \Drupal::currentUser();
  $headers = ['Content-Type' => \Drupal::service('file.mime_type.guesser')->guessMimeType($uri)];
  if ($account->hasPermission('administer hwdesk')) {
    return $headers;
  }
  $files = \Drupal::entityTypeManager()->getStorage('file')->loadByProperties(['uri' => $uri]);
  $file = reset($files);
  if (!$file instanceof FileInterface) {
    return -1;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('hwdesk_handover');
  $handovers = $storage->getQuery()->accessCheck(FALSE)->condition('protocol_file', $file->id())->condition('user', $account->id())->range(0, 1)->execute();
  if ($handovers) {
    return $headers;
  }
  $assets = \Drupal::entityTypeManager()->getStorage('hwdesk_asset')->getQuery()->accessCheck(FALSE)->condition('attachments', $file->id())->condition('holder', $account->id())->range(0, 1)->execute();
  return $assets ? $headers : -1;
}
