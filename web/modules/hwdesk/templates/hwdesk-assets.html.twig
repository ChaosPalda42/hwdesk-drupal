{#
/**
 * Zařízení — seznam s filtry, hromadnými akcemi a řazením.
 */
#}
{% import '@hwdesk/hwdesk-macros.html.twig' as m %}
{% embed '@hwdesk/hwdesk-topbar.html.twig' with {
  title: 'Zařízení'|t,
  subtitle: '@count položek v evidenci'|t({'@count': total}),
} %}
  {% block actions %}
    <a class="btn secondary" href="{{ links.export }}">{{ m.icon('download') }} {{ 'Export CSV'|t }}</a>
    <a class="btn secondary" href="{{ links.import }}">{{ m.icon('upload') }} {{ 'Import CSV'|t }}</a>
    <a class="btn secondary" href="{{ links.intake }}">{{ m.icon('inbox') }} {{ 'Příjem'|t }}</a>
    <a class="btn" href="{{ links.add }}">{{ m.icon('plus') }} {{ 'Nové zařízení'|t }}</a>
  {% endblock %}
{% endembed %}

<form method="get" class="filters" action="{{ path('hwdesk.assets') }}">
  <div class="field grow">
    <label for="f-q">{{ 'Hledat'|t }}</label>
    <input id="f-q" type="search" name="q" value="{{ filters.q|default('') }}" placeholder="{{ 'inventární číslo, název, sériové číslo, model…'|t }}">
  </div>
  <div class="field">
    <label for="f-type">{{ 'Typ'|t }}</label>
    <select id="f-type" name="type"><option value="">{{ 'Vše'|t }}</option>
      {% for key, label in options.types %}<option value="{{ key }}" {{ filters.type|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="f-status">{{ 'Stav'|t }}</label>
    <select id="f-status" name="status"><option value="">{{ 'Vše'|t }}</option>
      {% for key, label in options.statuses %}<option value="{{ key }}" {{ filters.status|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="f-tag">{{ 'Štítek'|t }}</label>
    <select id="f-tag" name="tag"><option value="">{{ 'Vše'|t }}</option>
      {% for id, label in options.tags %}<option value="{{ id }}" {{ filters.tag|default('') == id ~ "" ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="f-location">{{ 'Lokalita'|t }}</label>
    <select id="f-location" name="location"><option value="">{{ 'Vše'|t }}</option>
      {% for id, label in options.locations %}<option value="{{ id }}" {{ filters.location|default('') == id ~ "" ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="f-holder">{{ 'Držitel'|t }}</label>
    <select id="f-holder" name="holder"><option value="">{{ 'Kdokoli'|t }}</option>
      {% for id, label in options.holders %}<option value="{{ id }}" {{ filters.holder|default('') == id ~ "" ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="f-condition">{{ 'Stav kusu'|t }}</label>
    <select id="f-condition" name="condition"><option value="">{{ 'Vše'|t }}</option>
      {% for key, label in options.conditions %}<option value="{{ key }}" {{ filters.condition|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="f-warranty">{{ 'Záruka'|t }}</label>
    <select id="f-warranty" name="warranty"><option value="">{{ 'Vše'|t }}</option>
      {% for key, label in {'30': 'končí do 30 dnů'|t, '90': 'končí do 90 dnů'|t, '180': 'končí do 180 dnů'|t, 'expired': 'prošlá'|t} %}<option value="{{ key }}" {{ filters.warranty|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <input type="hidden" name="sort" value="{{ sort }}">
  <button class="btn secondary" type="submit">{{ m.icon('search') }} {{ 'Filtrovat'|t }}</button>
  {% if filters %}<a class="btn ghost" href="{{ links.reset }}">{{ 'Zrušit filtry'|t }}</a>{% endif %}
</form>

{{ bulk_form }}

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th style="width:28px"><input type="checkbox" id="selall" title="{{ 'Vybrat vše na stránce'|t }}"></th>
        {{ m.th('tag', 'Zařízení'|t, sort, base) }}
        {{ m.th('type', 'Typ'|t, sort, base) }}
        <th>{{ 'Sériové číslo'|t }}</th>
        {{ m.th('status', 'Stav'|t, sort, base) }}
        <th>{{ 'Držitel'|t }}</th>
        <th>{{ 'Lokalita'|t }}</th>
        <th>{{ 'Štítky'|t }}</th>
        {{ m.th('warranty_until', 'Záruka do'|t, sort, base) }}
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for a in rows %}
        <tr>
          <td><input type="checkbox" class="rowsel" value="{{ a.id }}" aria-label="{{ a.tag }}"></td>
          <td>{{ m.asset_cell(a) }}</td>
          <td><a class="quiet" href="{{ path('hwdesk.assets') }}?type={{ a.type }}">{{ a.type_label }}</a></td>
          <td class="mono">{{ a.serial_number ?: '—' }}</td>
          <td>{{ m.status(a.status, a.status_label) }}</td>
          <td>{% if a.holder %}<a href="{{ a.holder.url }}">{{ a.holder.name }}</a>
            {%- elseif a.prepared_for %}<span class="muted small">{{ 'připraveno pro'|t }}</span> <a href="{{ a.prepared_for.url }}">{{ a.prepared_for.name }}</a>
            {%- else %}<span class="muted">—</span>{% endif %}</td>
          <td>{% if a.location %}<a class="quiet" href="{{ path('hwdesk.assets') }}?location={{ a.location.id }}">{{ a.location.name }}</a>{% else %}<span class="muted">—</span>{% endif %}</td>
          <td>{{ m.tags(a.tags) }}</td>
          <td class="nowrap {{ a.warranty_label ? '' : 'muted' }}">{{ a.warranty_label ?: '—' }}</td>
          <td class="actions"><a class="btn ghost sm" href="{{ a.url }}">{{ 'Detail'|t }}</a></td>
        </tr>
      {% else %}
        <tr><td colspan="10">{{ m.empty('Žádné zařízení neodpovídá filtru.'|t) }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="table-foot">
    <span>{{ 'Stránka @page z @pages · @total položek'|t({'@page': page, '@pages': pages, '@total': total}) }}</span>
    {{ m.pagination(page, pages, base ~ '&sort=' ~ sort) }}
  </div>
</div>
