{% macro icon(name, cls='') -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ (ICONS[name]|default(ICONS['other']))|raw }}</svg>
{%- endmacro %}

{% macro status(value, label) -%}<span class="badge status-{{ value }}" data-status="{{ value }}">{{ label }}</span>{%- endmacro %}

{% macro condition(value, label) -%}{% if value %}<span class="badge cond-{{ value }}">{{ label }}</span>{% endif %}{%- endmacro %}

{% macro tags(list) -%}{% for t in list %}<a class="tag tag-{{ t.color }}" href="{{ path('hwdesk.assets') }}?tag={{ t.id }}" title="{{ 'Zařízení se štítkem'|t }} {{ t.name }}">{{ t.name }}</a>{% endfor %}{%- endmacro %}

{% macro money(value) -%}{{ value is empty ? '—' : (value|number_format(0, ',', ' ') ~ ' Kč') }}{%- endmacro %}

{% macro asset_cell(a) -%}
<div class="asset-cell">
  <span class="ico">{{ _self.icon(a.type) }}</span>
  <div><div class="t"><a href="{{ a.url }}">{{ a.tag }}</a></div><div class="s">{{ a.name ?: (a.manufacturer ~ ' ' ~ a.model)|trim }}</div></div>
</div>
{%- endmacro %}

{% macro pagination(page, pages, base) -%}
{% if pages > 1 %}<div class="pages">
  {%- for p in 1..pages -%}
    {%- if p == page %}<span class="cur">{{ p }}</span>
    {%- elseif p <= 2 or p >= pages - 1 or (p - page)|abs <= 2 %}<a href="{{ base }}&page={{ p }}">{{ p }}</a>
    {%- elseif (p - page)|abs == 3 %}<span>…</span>
    {%- endif -%}
  {%- endfor -%}
</div>{% endif %}
{%- endmacro %}

{% macro empty(text, ico='box') -%}<div class="empty">{{ _self.icon(ico) }}<div>{{ text }}</div></div>{%- endmacro %}

{#
 # Hlavička sloupce, kterým se dá řadit. Stejná úmluva jako v předloze:
 # sort=klíč vzestupně, sort=-klíč klesajícně.
 #}
{% macro th(col, label, sort, base) -%}
{%- set desc = sort == '-' ~ col -%}
<th><a class="{{ sort in [col, '-' ~ col] ? 'sorted' }} {{ desc ? 'desc' }}" href="{{ base }}&sort={{ (desc or sort != col) ? col : '-' ~ col }}">{{ label }}</a></th>
{%- endmacro %}
