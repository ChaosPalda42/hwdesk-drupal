{#
/**
 * Audit — kdo, co a kdy změnil.
 */
#}
{% import '@hwdesk/hwdesk-macros.html.twig' as m %}
{% embed '@hwdesk/hwdesk-topbar.html.twig' with {
  title: 'Audit'|t,
  subtitle: 'Každá změna v evidenci má svůj řádek'|t,
} %}{% endembed %}

<form method="get" class="filters" action="{{ path('hwdesk.audit') }}">
  <div class="field grow">
    <label for="a-q">{{ 'Hledat'|t }}</label>
    <input id="a-q" type="search" name="q" value="{{ filters.q|default('') }}" placeholder="{{ 'název objektu nebo text zprávy'|t }}">
  </div>
  <div class="field">
    <label for="a-action">{{ 'Akce'|t }}</label>
    <select id="a-action" name="action"><option value="">{{ 'Vše'|t }}</option>
      {% for key, label in options.actions %}<option value="{{ key }}" {{ filters.action|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="a-target">{{ 'Objekt'|t }}</label>
    <select id="a-target" name="target_type"><option value="">{{ 'Vše'|t }}</option>
      {% for key, label in options.targets %}<option value="{{ key }}" {{ filters.target_type|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}
    </select>
  </div>
  <button class="btn secondary" type="submit">{{ m.icon('search') }} {{ 'Filtrovat'|t }}</button>
  {% if filters %}<a class="btn ghost" href="{{ path('hwdesk.audit') }}">{{ 'Zrušit filtry'|t }}</a>{% endif %}
</form>

<div class="table-wrap">
  <table>
    <thead><tr><th>{{ 'Kdy'|t }}</th><th>{{ 'Kdo'|t }}</th><th>{{ 'Akce'|t }}</th><th>{{ 'Objekt'|t }}</th><th>{{ 'Detail'|t }}</th></tr></thead>
    <tbody>
      {% for e in rows %}
        <tr>
          <td class="nowrap">{{ e.when }}</td>
          <td>{{ e.who }}</td>
          <td class="mono">{{ e.action }}</td>
          <td>{% if e.target_url %}<a href="{{ e.target_url }}">{{ e.target_label ?: e.target_type }}</a>{% else %}{{ e.target_label ?: e.target_type }}{% endif %}</td>
          <td class="small muted">{{ e.message }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5">{{ m.empty('Zatím žádné záznamy.'|t, 'audit') }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="table-foot">
    <span>{{ 'Stránka @page z @pages · @total záznamů'|t({'@page': page, '@pages': pages, '@total': total}) }}</span>
    {{ m.pagination(page, pages, base) }}
  </div>
</div>
